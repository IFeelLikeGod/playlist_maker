<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/track_item_padding_horizontal"
    android:paddingVertical="@dimen/track_item_padding_vertical">

    <ImageView
        android:id="@+id/trackImage"
        android:layout_width="@dimen/track_image_size"
        android:layout_height="@dimen/track_image_size"
        android:scaleType="centerCrop"
        android:background="@drawable/placeholder"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/track_text_margin_start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/TrackNameTextStyle"
            android:ellipsize="end"
            tools:text="Trackname" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/track_artist_time_margin_top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trackArtistTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/TrackArtistTimeTextStyle"
                tools:text="Artist name • " />

            <TextView
                android:id="@+id/trackTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/TrackArtistTimeTextStyle"
                tools:text="5:01" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/track_chevron_size"
        android:layout_height="@dimen/track_chevron_size"
        android:src="@drawable/chevron_right"
        app:tint="@color/chevron_color"
        tools:ignore="ContentDescription" />

</LinearLayout>