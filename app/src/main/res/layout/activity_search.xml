<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_screen">

    <ImageButton
        android:id="@+id/ivBack"
        android:layout_width="@dimen/search_back_button_size"
        android:layout_height="@dimen/search_back_button_size"
        android:layout_marginStart="@dimen/search_back_margin_start"
        android:layout_marginTop="@dimen/search_back_margin_top"
        android:src="@drawable/arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/icon_primary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_title_margin_start"
        android:text="@string/search"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/search_title_text_size"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:layout_constraintBottom_toBottomOf="@id/ivBack" />

    <FrameLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_container_height"
        android:layout_marginStart="@dimen/search_container_margin"
        android:layout_marginTop="@dimen/search_container_margin"
        android:layout_marginEnd="@dimen/search_container_margin"
        android:background="@drawable/bg_search_field"
        android:paddingStart="@dimen/search_field_padding_horizontal"
        android:paddingEnd="@dimen/search_field_padding_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="@dimen/search_icon_size"
            android:layout_height="@dimen/search_icon_size"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/loop_light_mode"
            android:contentDescription="@string/search" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/search_text_color"
            android:textColorHint="@color/search_hint_color"
            android:paddingStart="@dimen/search_edit_padding_start"
            android:paddingEnd="@dimen/search_edit_padding_end" />

        <ImageView
            android:id="@+id/ivClear"
            android:layout_width="@dimen/search_clear_icon_size"
            android:layout_height="@dimen/search_clear_icon_size"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            android:contentDescription="@string/clear"
            app:tint="@color/search_clear_color" />

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/search_recycler_margin_top"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_track" />

    <LinearLayout
        android:id="@+id/placeholderEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/placeholder_image_size"
            android:gravity="center"
            android:src="@drawable/not_found"
            android:fontFamily="@font/ys_display_bold"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/placeholder_text_margin_top"
            android:text="@string/nothing_found"
            android:fontFamily="@font/ys_display_bold"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/placeholder_text_size" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/placeholderError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/placeholder_image_size"
            android:gravity="center"
            android:src="@drawable/placeholder_no_internet"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/placeholder_text_margin_top"
            android:gravity="center"
            android:text="@string/no_connection"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/placeholder_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/placeholder_button_margin_top"
            style="@style/RetryButton"
            android:text="@string/refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recentSearchesContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="visible"
        android:paddingStart="@dimen/search_container_margin"
        android:paddingEnd="@dimen/search_container_margin"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/recent_searches_margin_top"
            android:text="@string/recent_searches"
            android:textColor="@color/text_recent_searches"
            style="@style/recentSearches"
            android:textSize="@dimen/recent_searches_size" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentSearchesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_track" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:text="@string/clear_recent_searches"
            style="@style/ClearHistoryButton">
        </com.google.android.material.button.MaterialButton>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>