<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MessageTextStyle">
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/main_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_heavy</item>
        <item name="backgroundTint">@color/main_button_background</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/main_button_icon</item>
    </style>

    <style name="TrackNameTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/track_name_text_size</item>
        <item name="android:textColor">@color/track_name_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TrackArtistTimeTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/track_artist_time_text_size</item>
        <item name="android:textColor">@color/track_artist_time_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="ArtistName">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/track_name_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/track_artist_time_text_size</item>
    </style>

    <style name="DetailLabelTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/detail_text_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="DetailValueTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/detail_text_size</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconTint">@color/yp_black</item>
    </style>
    <style name="RetryButton">
        <item name="android:backgroundTint">@color/button_refresh_background</item>
        <item name="android:textColor">@color/button_refresh_text_color</item>
    </style>
    <style name="ClearHistoryButton">
        <item name="android:backgroundTint">@color/button_refresh_background</item>
        <item name="android:textColor">@color/button_refresh_text_color</item>
        <item name="cornerRadius">54dp</item>
    </style>
    <style name="recentSearches">
        <item name="android:fontFamily">@font/ys_display_bold</item>
    </style>
    <style name="placeholder_no_internet_con">
        <item name="android:src">@drawable/placeholder_no_internet</item>
    </style>
</resources>